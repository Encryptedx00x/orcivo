*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Prisma
prisma/migrations/*.sql.bak

# Transcripts / prompts (do not version)
*.transcript
.agents/

# Agent orchestration — runtime only. Tracked: config.json, README.md.
.orchestration/*
!.orchestration/config.json
!.orchestration/README.md
# V2 security spine — tracked: config.v2.json, README.md, schemas/. Runtime ignored.
!.orchestration/v2/
.orchestration/v2/*
!.orchestration/v2/config.v2.json
!.orchestration/v2/README.md
!.orchestration/v2/schemas/
.orchestration/v2/schemas/*
!.orchestration/v2/schemas/*.json
.deploy-secrets/
