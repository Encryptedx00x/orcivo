# Integration-test environment. Copy to .env.test:  cp .env.test.example .env.test
# Aligned with infra/docker-compose.test.yml (dedicated ports, isolated from dev).
#
#   docker compose -f infra/docker-compose.test.yml up -d
#   DATABASE_URL="postgresql://orcivo:orcivo@localhost:5433/orcivo_test?schema=public" npx prisma migrate deploy
#   pnpm --filter @orcivo/backend test:ci
#
# The db name must match the ephemeral-db guard: /orcivo_(test|verify|uat)*

DATABASE_URL="postgresql://orcivo:orcivo@localhost:5433/orcivo_test?schema=public"
DATABASE_URL_TEST="postgresql://orcivo:orcivo@localhost:5433/orcivo_test?schema=public"

JWT_ACCESS_SECRET="test-access-secret-minimum-32-chars-long"
JWT_REFRESH_SECRET="test-refresh-secret-minimum-32-chars-long"

REDIS_HOST=localhost
REDIS_PORT=6380

MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9002
STORAGE_SIGNED_URL_TTL=300
MINIO_BUCKET=orcivo-test

MAIL_PROVIDER=console
