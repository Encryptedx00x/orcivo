PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Dev DB: matches infra/docker-compose.dev.yml (db orcivo_dev, port 5432)
DATABASE_URL="postgresql://orcivo:orcivo@localhost:5432/orcivo_dev?schema=public"
# Test DB: matches infra/docker-compose.test.yml (db orcivo_test, port 5433).
# Name must match the ephemeral-db guard: /orcivo_(test|verify|uat)*
DATABASE_URL_TEST="postgresql://orcivo:orcivo@localhost:5433/orcivo_test?schema=public"

# JWT — ACCESS e REFRESH DEVEM ser segredos DISTINTOS
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-different-from-access"

REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (Storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000

# Mail
MAIL_PROVIDER=console
RESEND_API_KEY=re_xxx
RESEND_FROM=noreply@orcivo.com.br

# Asaas (billing) — placeholders. Real integration is Nível C (approval + secret).
# ASAAS_ENV: sandbox | production (default sandbox). ASAAS_API_KEY: server key.
# ASAAS_WEBHOOK_TOKEN: shared secret sent by Asaas in the webhook auth header.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# App URLs (para links em e-mails)
APP_WEB_URL=http://localhost:3001
