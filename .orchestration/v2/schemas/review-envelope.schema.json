{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orcivo.orchestration.v2.review-envelope/1",
  "title": "Orcivo V2 cross-review envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskVersion",
    "reviewedHead",
    "treeHash",
    "diffHash",
    "specHash",
    "verdict",
    "criteria",
    "findings",
    "filesReviewed",
    "reviewerMeta"
  ],
  "properties": {
    "schemaVersion": { "const": "orcivo.orchestration.v2.review-envelope/1" },
    "taskVersion": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewedHead": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "treeHash": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "diffHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "specHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REQUEST_CHANGES", "HUMAN_REVIEW_REQUIRED", "INCOMPLETE_REVIEW"]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "met", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "met": { "type": "boolean" },
          "evidence": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "detail"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "filesReviewed": { "type": "array", "items": { "type": "string" } },
    "reviewerMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "effort", "toolPolicy", "promptTemplateVersion"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "effort": { "type": "string" },
        "toolPolicy": { "type": "string" },
        "promptTemplateVersion": { "type": "string" }
      }
    }
  }
}
