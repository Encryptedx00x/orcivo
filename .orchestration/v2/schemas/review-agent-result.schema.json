{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orcivo.orchestration.v2.review-agent-result/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskVersion",
    "reviewedHead",
    "treeHash",
    "diffHash",
    "specHash",
    "verdict",
    "criteria",
    "findings",
    "filesReviewed",
    "reviewerMeta"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "orcivo.orchestration.v2.review-envelope/1" },
    "taskVersion": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewedHead": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "treeHash": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "diffHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "specHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REQUEST_CHANGES", "BLOCK", "ESCALATE_LEVEL_C"]
    },
    "criteria": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "met", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$" },
          "met": { "type": "boolean" },
          "evidence": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "detail"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] },
          "detail": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "filesReviewed": {
      "type": "array",
      "maxItems": 2000,
      "items": { "type": "string", "maxLength": 512 }
    },
    "reviewerMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "effort", "toolPolicy", "promptTemplateVersion"],
      "properties": {
        "provider": { "type": "string", "maxLength": 64 },
        "model": { "type": "string", "maxLength": 128 },
        "effort": { "type": "string", "maxLength": 64 },
        "toolPolicy": { "type": "string", "maxLength": 64 },
        "promptTemplateVersion": { "type": "string", "maxLength": 64 }
      }
    }
  }
}
