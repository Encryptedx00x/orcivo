{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "orcivo.orchestration.v2.review-agent-result/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskVersion",
    "reviewedHead",
    "treeHash",
    "diffHash",
    "specHash",
    "verdict",
    "criteria",
    "findings",
    "filesReviewed",
    "technicalBlock",
    "reviewerMeta"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "orcivo.orchestration.v2.review-envelope/1" },
    "taskVersion": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reviewedHead": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "treeHash": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "diffHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "specHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "verdict": {
      "type": "string",
      "enum": ["APPROVE", "REQUEST_CHANGES", "BLOCK", "ESCALATE_LEVEL_C"]
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "met", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$" },
          "met": { "type": "boolean" },
          "evidence": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "detail"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] },
          "file": {
            "anyOf": [{ "type": "null" }, { "type": "string" }]
          },
          "line": {
            "anyOf": [{ "type": "null" }, { "type": "integer" }]
          },
          "detail": { "type": "string" }
        }
      }
    },
    "filesReviewed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "technicalBlock": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "failure",
            "artifact",
            "pageOffset",
            "expectedSha256",
            "detail"
          ],
          "properties": {
            "classification": { "type": "string", "const": "REVIEW_INFRASTRUCTURE" },
            "failure": { "type": "string", "enum": ["ARTIFACT_READ_FAILURE"] },
            "artifact": { "type": "string", "enum": ["acceptance.txt", "spec.txt", "diff.patch"] },
            "pageOffset": { "type": "integer", "minimum": 0 },
            "expectedSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "detail": { "type": "string" }
          }
        }
      ]
    },
    "reviewerMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "effort", "toolPolicy", "promptTemplateVersion"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "effort": { "type": "string" },
        "toolPolicy": { "type": "string" },
        "promptTemplateVersion": { "type": "string" }
      }
    }
  }
}
