{
  "$meta": {
    "name": "Orcivo Design System",
    "brand": "branco · preto · roxo (white · black · purple)",
    "language": "pt-BR",
    "version": "1.0.0",
    "note": "Source of truth for all Orcivo UI generation. Use these values literally — never invent new colors, sizes, radii, or shadows. Mirror of tokens.css."
  },
  "color": {
    "purple-50":  "#F5F3FF",
    "purple-100": "#EDE9FE",
    "purple-200": "#DDD6FE",
    "purple-300": "#C4B5FD",
    "purple-400": "#A78BFA",
    "purple-500": "#8B5CF6",
    "purple-600": "#6D28D9",
    "purple-700": "#5B21B6",
    "purple-800": "#4C1D95",
    "purple-900": "#3B0A6E",
    "ink":        "#0A0A0F",
    "bg":         "#FFFFFF",
    "slate-50":   "#F8FAFC",
    "slate-100":  "#F1F5F9",
    "slate-200":  "#E2E8F0",
    "slate-300":  "#CBD5E1",
    "slate-400":  "#94A3B8",
    "slate-500":  "#64748B",
    "slate-600":  "#475569",
    "slate-700":  "#334155",
    "slate-800":  "#1E293B",
    "slate-900":  "#0F172A",
    "slate-950":  "#020617",
    "success":    "#16A34A",
    "success-bg": "#DCFCE7",
    "warning":    "#D97706",
    "warning-bg": "#FEF3C7",
    "danger":     "#DC2626",
    "danger-bg":  "#FEE2E2",
    "info":       "#0284C7",
    "info-bg":    "#E0F2FE"
  },
  "role": {
    "primary":        "{color.purple-600}",
    "primary-hover":  "{color.purple-700}",
    "primary-pressed":"{color.purple-800}",
    "primary-tint":   "{color.purple-50}",
    "fg-1":           "{color.ink}",
    "fg-2":           "{color.slate-700}",
    "fg-3":           "{color.slate-500}",
    "fg-disabled":    "{color.slate-400}",
    "fg-on-brand":    "#FFFFFF",
    "bg-1":           "#FFFFFF",
    "bg-2":           "{color.slate-50}",
    "bg-3":           "{color.slate-100}",
    "bg-brand":       "{color.purple-600}",
    "bg-brand-soft":  "{color.purple-50}",
    "border-1":       "{color.slate-200}",
    "border-2":       "{color.slate-100}",
    "border-focus":   "{color.purple-600}"
  },
  "font": {
    "sans": "\"Inter\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
  },
  "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
  "type": {
    "display": { "size": "32px", "line": "40px", "weight": 700, "tracking": "-0.02em", "use": "Marketing only" },
    "h1":      { "size": "28px", "line": "36px", "weight": 700, "tracking": "-0.02em", "use": "Page title" },
    "h2":      { "size": "24px", "line": "32px", "weight": 700, "tracking": "-0.015em", "use": "Section title" },
    "h3":      { "size": "20px", "line": "28px", "weight": 600, "tracking": "-0.01em", "use": "Card / dialog title" },
    "body":    { "size": "16px", "line": "24px", "weight": 400, "use": "Default text" },
    "small":   { "size": "14px", "line": "20px", "weight": 400, "use": "Helper, table cells" },
    "caption": { "size": "12px", "line": "16px", "weight": 400, "use": "Labels, metadata" },
    "button":  { "size": "14px", "line": "20px", "weight": 600, "use": "CTAs" }
  },
  "space": {
    "xs": "4px", "sm": "8px", "md": "12px", "lg": "16px",
    "xl": "24px", "2xl": "32px", "3xl": "48px", "4xl": "64px",
    "base": "4px scale: 4 · 8 · 12 · 16 · 24 · 32 · 48"
  },
  "layout": {
    "mobile-screen-pad": "16px",
    "web-page-pad": "32px",
    "sidebar-w": "260px",
    "header-h": "64px",
    "tabbar-h": "64px",
    "form-max-w": "960px",
    "table-max-w": "1440px",
    "touch-target": "44px"
  },
  "radius": {
    "sm": "8px", "md": "12px", "lg": "16px", "xl": "20px", "2xl": "24px", "pill": "9999px",
    "usage": { "input": "12px", "card-web": "16px", "card-mobile": "12px", "modal": "20px", "bottom-sheet-top": "24px", "badge": "9999px" }
  },
  "shadow": {
    "card":  "0 1px 3px rgba(15, 23, 42, 0.08)",
    "pop":   "0 4px 12px rgba(15, 23, 42, 0.10)",
    "modal": "0 20px 40px rgba(15, 23, 42, 0.18)",
    "focus": "0 0 0 4px #DDD6FE",
    "rule":  "Resting cards have NO shadow. Cards lead with border. Shadow only on hover/lift, FAB, dropdowns, modals."
  },
  "border": {
    "hairline": "1px solid #E2E8F0",
    "divider-in-card": "1px solid #F1F5F9",
    "focus": "2px solid #6D28D9 + 4px #DDD6FE halo"
  },
  "motion": {
    "ease-out":   "cubic-bezier(0.2, 0, 0, 1)",
    "ease-in":    "cubic-bezier(0.4, 0, 1, 1)",
    "ease-inout": "cubic-bezier(0.4, 0, 0.2, 1)",
    "dur-fast":  "120ms",
    "dur-base":  "200ms",
    "dur-sheet": "280ms",
    "rule": "No bouncy springs, no parallax, no scale, no celebratory motion. Page transition = 120ms cross-fade."
  },
  "icon": {
    "library": "Lucide (lucide-react web, lucide-react-native mobile)",
    "stroke": 1.75,
    "sizes": { "inline": 16, "button": 20, "header": 24, "illustration": 32 },
    "color": "currentColor (mono — never two-tone or fill+stroke)"
  },
  "plans": {
    "note": "Provisional Orcivo plan names. NEVER use FREE / POP / PRO / TOP or any price like R$ 24,90 in UI.",
    "tiers": ["Orcivo Livre", "Orcivo Solo", "Orcivo Mais", "Orcivo Equipe"],
    "limit-language": ["uso justo", "uso ampliado", "incluído no plano"],
    "avoid": ["ilimitado", "FREE", "PRO", "TOP", "POP", "14 dias PRO"]
  }
}
