# Orcivo orchestration - disposable agent / test runner image.
#
# PRAGMATIC V2.1 / THREAT_MODEL = LOCAL_TRUSTED_HOST. This container CONTAINS the
# untrusted implementer agent and any candidate-controlled build/test code. It is
# NOT a defence of the trusted Windows host against itself.
#
# Invariants (enforced by runner-docker.ps1 at `docker run` time, not here):
#   - candidate clone mounted READ-ONLY (writes go to a tmpfs overlay / out dir)
#   - test runner gets `--network none`
#   - no `-v /var/run/docker.sock`
#   - no HOME / USERPROFILE mount, no secrets in the environment
#   - non-root user, `--rm`, cpu / memory / pids caps
#
# Build:  docker build -f infra/orchestration/Dockerfile.agent-runner -t orcivo-agent-runner:v1 infra/orchestration
# The pilot never builds or pulls without an explicit owner action.

FROM node:22-bookworm-slim

# minimal toolchain: git for the candidate clone, ca-certs, tini as PID 1,
# pnpm via corepack (Orcivo is a pnpm monorepo). No editors, no shells beyond sh/bash.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends git ca-certificates tini; \
    rm -rf /var/lib/apt/lists/*; \
    corepack enable; \
    useradd --create-home --shell /usr/sbin/nologin --uid 10001 runner; \
    mkdir -p /work /candidate /out; \
    chown -R runner:runner /work /out

# the harness passes the exact command; this image only provides the sandboxed
# toolchain. Default is a no-op that prints the toolchain versions.
USER runner
WORKDIR /work
ENV CI=1 \
    npm_config_fund=false \
    npm_config_audit=false \
    HOME=/home/runner

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-lc", "node -v && corepack pnpm -v && git --version"]
