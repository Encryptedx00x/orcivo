# .env.example — Copiar para .env e preencher valores reais
# NUNCA commitar o arquivo .env no repositório
# Guardar valores reais no Bitwarden (ou gerenciador de senha preferido)

# PostgreSQL
POSTGRES_DB=orcivo_prod
POSTGRES_USER=orcivo
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# Redis
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# MinIO
MINIO_ROOT_USER=orcivo_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password_min_12_chars

# Domínio (substituir pelo domínio real quando comprado)
DOMAIN=seudominio.com.br

# Email para Let's Encrypt (Caddy)
ACME_EMAIL=seu@email.com
